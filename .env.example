# Sylloge Central Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific credentials and configurations.

# Application & Environment
APP_NAME="Sylloge"
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Admin Credentials
ADMIN_EMAIL=admin@sylloge.internal
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password_here

# Database Configuration
POSTGRES_USER=satsa_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=satsa_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SYNC_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_ROOT_USER=your_minio_access_key_here
MINIO_ROOT_PASSWORD=your_minio_secret_key_here
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Object Storage Buckets
BUCKET_RAW_SUBMISSIONS=raw-submissions
BUCKET_QUARANTINED_DUMPS=quarantined-dumps
BUCKET_EVIDENCE_RECORDS=evidence-records
BUCKET_AUDIT_MANIFESTS=audit-manifests
BUCKET_REPORTS=reports

# Authentication & Security
JWT_SECRET_KEY=your_random_32_plus_character_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_LEEWAY_SECONDS=60
INTERNAL_SERVICE_KEY=your_random_internal_service_authentication_token_here

# Microservice Network Hosts & Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATA_PROCESSING_HOST=0.0.0.0
DATA_PROCESSING_PORT=8001
ANALYTICS_ENGINE_HOST=0.0.0.0
ANALYTICS_ENGINE_PORT=8002
AUDIT_SERVICE_HOST=0.0.0.0
AUDIT_SERVICE_PORT=8003

# Microservice Interconnect URLs
BACKEND_API_URL=http://backend:8000
DATA_PROCESSING_URL=http://data-processing:8001
ANALYTICS_ENGINE_URL=http://analytics-engine:8002
AUDIT_SERVICE_URL=http://audit-service:8003
FRONTEND_URL=http://frontend:3000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://frontend:3000"]

# Data Processing Microservice Configuration
DATA_PROCESSING_BATCH_INSERT_SIZE=1000
DATA_PROCESSING_MAX_FILE_SIZE_BYTES=104857600
DEFAULT_TIMEZONE=UTC
AUTO_QUARANTINE_ON_VALIDATION_ERROR=true
MAX_ERRORS_PER_ROW=10

# Analytics Engine Rule Configuration
DEFAULT_SLA_INVESTIGATION_HOURS=2
DEFAULT_SLA_ESCALATION_HOURS=4
DEFAULT_STALE_CASE_HOURS=72
DEFAULT_OFF_HOURS_SLA_MINUTES=60

EWMA_ALPHA=0.20
EWMA_CLIFF_K=3.0
MIN_SAMPLE_SIZE_N=15
SHANNON_ENTROPY_MIN_BITS=0.50
CV_SYNTHETIC_HEARTBEAT_THRESHOLD=0.01

CORRELATION_BURST_WINDOW_HOURS=24
CORRELATION_REPEAT_ALERT_THRESHOLD=5
CORRELATION_REPEAT_HIGH_ALERT_THRESHOLD=3
TFIDF_COSINE_SIMILARITY_THRESHOLD=0.85
JACCARD_TOKEN_SIMILARITY_THRESHOLD=0.80

MIN_PEER_GROUP_SIZE=3
PEER_DAMPENING_LAMBDA=0.50

WEIGHT_EXECUTION_GAP=0.45
WEIGHT_NEGATIVE_SPACE=0.35
WEIGHT_PEER_DEVIATION=0.20
