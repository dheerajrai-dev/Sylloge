# ==========================================
# Sylloge .gitignore Configuration
# ==========================================

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!frontend/.env.example

# Node & Frontend Dependencies / Builds
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation & Markdown Files
docs/

# Data Dumps, Sample Data & Validation Output
sample-data/
synthetic_data/
sih_test_dataset


# Logs & Temporary Files
*.log
tmp/
temp/

# IDE & OS Specific
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.agents
